# OmniSight backend environment — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in locally. Never commit real secrets.

OMNISIGHT_APP_NAME=OmniSight Backend
OMNISIGHT_DEBUG=false
OMNISIGHT_LOG_LEVEL=INFO

# Comma-separated CORS allow-list (React dev server origins).
OMNISIGHT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local directories for evidence artifacts and data files.
OMNISIGHT_ARTIFACTS_DIR=artifacts
OMNISIGHT_DATA_DIR=data

# Optional shared secret used to verify CI/CD webhook calls (leave blank in dev).
# When blank the receiver is UNAUTHENTICATED — acceptable for the local
# simulation only; a startup warning is logged.
OMNISIGHT_CI_WEBHOOK_SECRET=

# CI webhook hardening.
OMNISIGHT_WEBHOOK_MAX_BODY_BYTES=65536
# Optional comma-separated allow-list of target hosts for successful builds
# (empty = permissive; local simulation only).
OMNISIGHT_TARGET_HOST_ALLOWLIST=

# Scan limits.
OMNISIGHT_MAX_SCAN_URL_LENGTH=2048
OMNISIGHT_SCAN_CREATE_RATE_LIMIT_PER_MINUTE=60

# Evidence / artifact handling.
OMNISIGHT_OBSERVATION_MAX_BYTES=1048576
OMNISIGHT_ARTIFACT_MAX_IMAGE_BYTES=5242880
OMNISIGHT_ARTIFACT_MAX_JSON_BYTES=1048576

# Feature flags — keep false until the corresponding module exists.
OMNISIGHT_ENABLE_PLAYWRIGHT_WORKER=false
OMNISIGHT_ENABLE_VLM_DETECTION=false
OMNISIGHT_ENABLE_PATCH_ENGINE=false
OMNISIGHT_ENABLE_GITHUB_DELIVERY=false

# AI Gateway (Week 2) — provider-neutral model boundary.
# ai_mode: "disabled" (default) | "fake" (deterministic offline adapter,
# used by tests/CI) | "live" (requires a real provider adapter).
# No provider or model id is hardcoded; set the names below when available.
OMNISIGHT_AI_MODE=disabled
OMNISIGHT_AI_VISUAL_PROVIDER=none
OMNISIGHT_AI_VISUAL_MODEL=none
OMNISIGHT_AI_PATCH_PROVIDER=none
OMNISIGHT_AI_PATCH_MODEL=none
OMNISIGHT_AI_PROVIDER_TIMEOUT_SECONDS=45
OMNISIGHT_AI_MAX_REPAIR_ATTEMPTS=1
OMNISIGHT_AI_MAX_OUTPUT_TOKENS=4096
OMNISIGHT_AI_MAX_FINDINGS=20
OMNISIGHT_AI_MAX_SCREENSHOTS_PER_ANALYSIS=6
OMNISIGHT_AI_MAX_CONCURRENT_CALLS=2
OMNISIGHT_AI_ALLOW_RAW_OUTPUT_STORAGE=false
