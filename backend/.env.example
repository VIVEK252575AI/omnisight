# OmniSight backend environment — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in locally. Never commit real secrets.

OMNISIGHT_APP_NAME=OmniSight Backend
OMNISIGHT_DEBUG=false
OMNISIGHT_LOG_LEVEL=INFO

# Comma-separated CORS allow-list (React dev server origins).
OMNISIGHT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local directories for evidence artifacts and data files.
OMNISIGHT_ARTIFACTS_DIR=artifacts
OMNISIGHT_DATA_DIR=data

# Optional shared secret used to verify CI/CD webhook calls (leave blank in dev).
# When blank the receiver is UNAUTHENTICATED — acceptable for the local
# simulation only; a startup warning is logged.
OMNISIGHT_CI_WEBHOOK_SECRET=

# CI webhook hardening.
OMNISIGHT_WEBHOOK_MAX_BODY_BYTES=65536
# Optional comma-separated allow-list of target hosts for successful builds
# (empty = permissive; local simulation only).
OMNISIGHT_TARGET_HOST_ALLOWLIST=

# Scan limits.
OMNISIGHT_MAX_SCAN_URL_LENGTH=2048
OMNISIGHT_SCAN_CREATE_RATE_LIMIT_PER_MINUTE=60

# Evidence / artifact handling.
OMNISIGHT_OBSERVATION_MAX_BYTES=1048576
OMNISIGHT_ARTIFACT_MAX_IMAGE_BYTES=5242880
OMNISIGHT_ARTIFACT_MAX_JSON_BYTES=1048576

# Feature flags — keep false until the corresponding module exists.
OMNISIGHT_ENABLE_PLAYWRIGHT_WORKER=false
OMNISIGHT_ENABLE_VLM_DETECTION=false
OMNISIGHT_ENABLE_PATCH_ENGINE=false

# GitHub App integration (disabled until credentials are configured).
# Generate a private key from the GitHub App settings; keep it server-side.
OMNISIGHT_ENABLE_GITHUB_APP=false
OMNISIGHT_ENABLE_GITHUB_PUBLISH_API=false
OMNISIGHT_GITHUB_APP_ID=
OMNISIGHT_GITHUB_APP_INSTALLATION_ID=
# PEM contents can be provided with literal \n between lines in environment files.
OMNISIGHT_GITHUB_APP_PRIVATE_KEY=
OMNISIGHT_ENABLE_GITHUB_DELIVERY=false
OMNISIGHT_GITHUB_TARGET_OWNER=
OMNISIGHT_GITHUB_TARGET_REPOSITORY=
OMNISIGHT_GITHUB_TARGET_BRANCH=main

# Local single-owner publishing API (loopback requests only).
# Use a random secret with at least 32 characters. Never commit the .env file.
OMNISIGHT_AUTH_MODE=disabled
OMNISIGHT_LOCAL_AUTH_TOKEN=
OMNISIGHT_LOCAL_PROJECT_ID=b13a29c2-4669-5ac7-9ba6-ff7c1d32ae11
OMNISIGHT_LOCAL_PROJECT_NAME=OmniSight ShopLite Demo
# PostgreSQL is the source of truth for projects, test flows, runs, proposals,
# validation, GitHub operations, and pull requests. Apply migrations before use.
OMNISIGHT_DATABASE_URL=postgresql+psycopg://omnisight:CHANGE_ME@127.0.0.1:5432/omnisight

# VLM adapter boundary (Week 2) — provider-neutral, config-selected.
# OMNISIGHT_VLM_ADAPTER selects the replaceable implementation:
#   mock     -> deterministic offline adapter (default; used by tests/CI)
#   gemini   -> Gemini multimodal analysis of stored screenshots
#   teammate -> wraps the teammate VLM module once its callable is injected
# An unknown value fails fast at application startup. Model selection and
# credentials are configurable; provider requests stay in backend adapters.
OMNISIGHT_VLM_ADAPTER=mock
# Offline mock scenario (deterministic, no model involved). One of:
#   clipped_button | healthy_page | needs_inspection | malformed_text |
#   malformed_schema | empty | timeout | provider_error
# The failure scenarios exist so error handling can be exercised without a
# provider. Anything the mock returns is labelled MOCK.
OMNISIGHT_VLM_MOCK_SCENARIO=clipped_button
OMNISIGHT_VLM_TIMEOUT_SECONDS=30
OMNISIGHT_VLM_MAX_IMAGE_BYTES=5242880
OMNISIGHT_VLM_MAX_IMAGES_PER_ANALYSIS=6

# AI gateway (validation layer over the adapter).
OMNISIGHT_AI_MAX_REPAIR_ATTEMPTS=1
OMNISIGHT_AI_MAX_OUTPUT_TOKENS=4096
OMNISIGHT_AI_MAX_FINDINGS=20
OMNISIGHT_AI_ALLOW_RAW_OUTPUT_STORAGE=false

# VLM detection workflow (POST /api/v1/scans/{id}/detect).
#   detection_max_candidates        upper bound on DOM candidates sent as
#                                   context (relevant elements are kept first)
#   detection_max_raw_output_bytes  cap on raw model text retained IN MEMORY
#                                   for audit; never written to disk
#   detection_expose_raw_output     debug flag: opt raw model text into API
#                                   responses (still requires ?include_raw=true)
OMNISIGHT_DETECTION_MAX_CANDIDATES=50
OMNISIGHT_DETECTION_MAX_RAW_OUTPUT_BYTES=8192
OMNISIGHT_DETECTION_EXPOSE_RAW_OUTPUT=false

# Safe action engine / patch proposals (POST /api/v1/findings/{id}/patch-proposals).
# Only validated proposal records and editable patch text are stored locally;
# raw model output remains in memory and is never persisted.
#   patch_generator            selects "mock" (offline) or "gemini" (live API);
#                              unknown values fail fast
#   patch_mock_scenario        offline mock behaviour, one of:
#                              ok | timeout | error | invalid_json | empty |
#                              prose_with_fence | two_plain_fences |
#                              two_tagged_fences | prose_only | truncated
#                              shoplite_checkout_fix (small deterministic demo edit)
#   approved_patch_paths       path ALLOW-LIST (comma-separated glob patterns,
#                              fnmatch semantics against the normalised path).
#                              DEFAULT IS EMPTY: with no approved paths every
#                              proposal is rejected. Populate this from the
#                              ShopLite owner's handoff.
#   patch_allowed_extensions   extensions a proposal may touch. Add .js/.ts to
#                              this list explicitly if they should be patchable.
#   patch_source_root          read-only root the context is read from; empty
#                              means there is no source tree to read.
#   max_patch_files            max files in one proposal
#   max_patch_bytes            max UTF-8 bytes of edit payload in one proposal
#   patch_context_max_bytes    cap on total source text handed to the generator
#   patch_max_response_bytes   cap on raw generator text handed to the extractor
#                              (enforced before parsing; oversized -> too_large)
# Use "gemini" after setting the Gemini key below; "mock" stays offline.
OMNISIGHT_PATCH_GENERATOR=mock
OMNISIGHT_PATCH_MOCK_SCENARIO=ok
OMNISIGHT_APPROVED_PATCH_PATHS=
OMNISIGHT_PATCH_ALLOWED_EXTENSIONS=.css,.scss,.jsx,.tsx
OMNISIGHT_PATCH_SOURCE_ROOT=
OMNISIGHT_MAX_PATCH_FILES=5
OMNISIGHT_MAX_PATCH_BYTES=4096
OMNISIGHT_PATCH_CONTEXT_MAX_BYTES=4096
OMNISIGHT_PATCH_MAX_RESPONSE_BYTES=16384

# Fixed ShopLite-only Docker validation (off unless explicitly enabled).
# Build the image described in demo-app/sandbox/Dockerfile before enabling.
# Use a long random local-only value for the approval token; never commit it.
OMNISIGHT_ENABLE_SHOPLITE_SANDBOX=false
OMNISIGHT_SHOPLITE_SANDBOX_TOKEN=
OMNISIGHT_SHOPLITE_SANDBOX_TIMEOUT_SECONDS=45

# Optional Gemini provider. VLM_ADAPTER=gemini enables visual detection;
# PATCH_GENERATOR=gemini enables the approved-source patch proposal flow.
# POST /api/ai/patch-suggestions remains available for a direct review-only call.
# Copy this placeholder to .env and set the key locally; never commit real keys.
OMNISIGHT_GEMINI_API_KEY=
OMNISIGHT_GEMINI_MODEL=gemini-3.6-flash
OMNISIGHT_GEMINI_TIMEOUT_SECONDS=30
OMNISIGHT_GEMINI_MAX_OUTPUT_TOKENS=4096
