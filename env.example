# ============================================================================
# OmniSight frontend: environment template
# ----------------------------------------------------------------------------
# Copy to .env and edit:   cp .env.example .env
# Then run:                npm run env      (writes js/env.js for the browser)
#
# ONLY variables starting with PUBLIC_ are copied to the browser.
# Everything in a browser is visible to every visitor, so NEVER put API keys,
# tokens, passwords or database URLs in this file. Those belong to the backend
# (see docs/backend.env.example).
# ============================================================================

# development | staging | production
PUBLIC_APP_ENV=development

# Base URL of the REST API (no trailing slash). Not a secret.
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Abort a request after this many milliseconds
PUBLIC_API_TIMEOUT_MS=15000

# true  = use fake responses from js/services/mock (no backend needed)
# false = call the real REST API
PUBLIC_USE_MOCKS=true

# cookie = backend sets an HttpOnly session cookie (recommended)
# bearer = backend returns a short-lived token that the frontend keeps in memory
PUBLIC_AUTH_MODE=cookie

# Model NAMES shown in the UI. Names only, never keys.
PUBLIC_DEFAULT_VLM=OmniVision-VL 7B
PUBLIC_DEFAULT_LLM=OmniCoder-LLM 70B

# Feature flags
PUBLIC_ENABLE_DEEP_SCAN=true
PUBLIC_ENABLE_PR_CREATION=false
