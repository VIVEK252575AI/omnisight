# ============================================================================
# OmniSight BACKEND environment template (for Laksh)
# ----------------------------------------------------------------------------
# These values must live ONLY on the backend (own .env file, host secret
# manager, or CI secrets). Never commit real values and never send any of them
# to the browser, not even inside an error message.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=8000
APP_ENV=development
# Exact origin(s) of the frontend, used for CORS (no wildcard when using cookies)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth / sessions (SECRET) -----------------------------------------------
JWT_SECRET=
SESSION_SECRET=
SESSION_COOKIE_NAME=omnisight_session
SESSION_TTL_MINUTES=60

# --- Data (SECRET) ----------------------------------------------------------
DATABASE_URL=
REDIS_URL=

# --- AI providers (SECRET). The frontend never calls these directly ----------
VLM_PROVIDER_BASE_URL=
VLM_API_KEY=
VLM_MODEL=OmniVision-VL 7B
LLM_PROVIDER_BASE_URL=
LLM_API_KEY=
LLM_MODEL=OmniCoder-LLM 70B

# --- Screenshots / browser automation ---------------------------------------
SCREENSHOT_STORAGE_BUCKET=
SCREENSHOT_STORAGE_KEY=

# --- GitHub (SECRET), only needed if pull-request creation is enabled ---------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
